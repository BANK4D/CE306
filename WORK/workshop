var rates = {
  USD: 1,
  THB: 33.16,
  EUR: 0.865,
  GBP: 0.739,
  JPY: 159.3,
  CNY: 7.1,
  KRW: 1460,
  SGD: 1.28,
  AUD: 1.53,
  NZD: 1.69,
  CAD: 1.37,
  CHF: 0.79,
  HKD: 7.83,
  INR: 92.5,
  MYR: 3.95,
  IDR: 16900,
  PHP: 59.5,
  VND: 26100
};

var a1 = document.getElementById("a1");
var a2 = document.getElementById("a2");

var c1 = document.getElementById("c1");
var c2 = document.getElementById("c2");

var rateLine = document.getElementById("rateLine");
var timeLine = document.getElementById("timeLine");

var histTable = document.getElementById("histTable");

var hist = [];
var last = "a1";


/* เพิ่มสกุลเงินลงในช่องเลือก */
for (var k in rates) {

  c1.innerHTML +=
    "<option value='" + k + "'>" + k + "</option>";

  c2.innerHTML +=
    "<option value='" + k + "'>" + k + "</option>";
}


/* ตั้งค่าเริ่มต้น */
c1.value = "USD";
c2.value = "THB";


function now() {
  return new Date().toLocaleString("th-TH");
}


function calc(from, to, amount) {
  return amount / rates[from] * rates[to];
}


function convert(direction, log) {

  var from = c1.value;
  var to = c2.value;

  if (direction == "a1") {

    var amount = parseFloat(a1.value) || 0;

    var result = calc(from, to, amount);

    a2.value = amount
      ? result.toFixed(4)
      : "";

    if (log) {
      addHist(
        amount,
        from,
        result.toFixed(4),
        to
      );
    }

  } else {

    var amount = parseFloat(a2.value) || 0;

    var result = calc(to, from, amount);

    a1.value = amount
      ? result.toFixed(4)
      : "";

    if (log) {
      addHist(
        result.toFixed(4),
        from,
        amount,
        to
      );
    }
  }

  rateLine.textContent =
    "1 " + from +
    " = " +
    (rates[to] / rates[from]).toFixed(4) +
    " " + to;

  timeLine.textContent =
    "ดึงข้อมูลล่าสุดเมื่อ: " + now();
}


/* เพิ่มประวัติ */
function addHist(fa, fc, ta, tc) {

  if (!fa || !ta) {
    return;
  }

  hist.unshift(
    fa + " " + fc +
    " → " +
    ta + " " + tc +
    " (" + now() + ")"
  );

  hist = hist.slice(0, 10);

  renderHist();
}


/* แสดงประวัติ */
function renderHist() {

  if (hist.length) {

    histTable.innerHTML = hist
      .map(function(h) {
        return "<tr><td>" + h + "</td></tr>";
      })
      .join("");

  } else {

    histTable.innerHTML =
      "<tr><td>ยังไม่มีประวัติ</td></tr>";
  }
}


/* ช่องแรก */
a1.oninput = function() {

  last = "a1";

  convert("a1", false);
};


a1.onblur = function() {

  if (parseFloat(a1.value) > 0) {
    convert("a1", true);
  }
};


/* ช่องที่สอง */
a2.oninput = function() {

  last = "a2";

  convert("a2", false);
};


a2.onblur = function() {

  if (parseFloat(a2.value) > 0) {
    convert("a2", true);
  }
};


/* เปลี่ยนสกุลเงิน */
c1.onchange = function() {

  convert(last, true);
};


c2.onchange = function() {

  convert(last, true);
};


/* ปุ่มสลับ */
document.getElementById("swap").onclick = function() {

  var temp = c1.value;

  c1.value = c2.value;
  c2.value = temp;

  convert(last, true);
};


/* ปุ่มล้างข้อมูล */
document.getElementById("clear").onclick = function() {

  a1.value = "1";
  a2.value = "";

  c1.value = "USD";
  c2.value = "THB";

  last = "a1";

  convert("a1", false);
};


/* ล้างประวัติ */
document.getElementById("clearHist").onclick = function() {

  hist = [];

  renderHist();
};


/* เริ่มต้น */
convert("a1", false);